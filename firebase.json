{
  "hosting": {
    "public": "packages/altair-app/dist/browser",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/iframe-sandbox",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "sandbox allow-scripts"
          }
        ]
      },
      {
        "source": "/iframe-sandbox/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "sandbox allow-scripts"
          }
        ]
      }
    ]
  }
}